+}
diff --git a/terraform/modules/sqs_queue/tests/defaults.tftest.hcl b/terraform/modules/sqs_queue/tests/defaults.tftest.hcl
new file mode 100644
index 0000000..375daa1
--- /dev/null
+++ b/terraform/modules/sqs_queue/tests/defaults.tftest.hcl
@@ -0,0 +1,31 @@
+mock_provider "aws" {
+  mock_resource "aws_sqs_queue" {
+    defaults = {
+      arn = "arn:aws:sqs:eu-central-1:111111111111:aigt-test-items-dlq"
+    }
+  }
+}
+
+variables {
+  name            = "aigt-test-items"
+  alarm_topic_arn = "arn:aws:sns:eu-central-1:111111111111:aigt-test-alarms"
+}
+
+run "queues_are_encrypted_with_a_dead_letter_queue" {
+  command = apply
+
+  assert {
+    condition     = aws_sqs_queue.this.sqs_managed_sse_enabled && aws_sqs_queue.dead_letter.sqs_managed_sse_enabled
+    error_message = "Both queues must be encrypted."
+  }
+
+  assert {
+    condition     = jsondecode(aws_sqs_queue.this.redrive_policy).maxReceiveCount == 3
+    error_message = "Messages must move to the dead-letter queue after 3 receives."
+  }
+
+  assert {
+    condition     = aws_cloudwatch_metric_alarm.dead_letter_messages.namespace == "AWS/SQS"
+    error_message = "The alarm must watch the dead-letter queue."
+  }
+}
diff --git a/terraform/modules/sqs_queue/variables.tf b/terraform/modules/sqs_queue/variables.tf
new file mode 100644
index 0000000..2632042
--- /dev/null
+++ b/terraform/modules/sqs_queue/variables.tf
@@ -0,0 +1,29 @@
+variable "name" {
+  type        = string
+  description = "Name of the queue; the dead-letter queue is named <name>-dlq"
+  validation {
+    condition     = can(regex("^[a-zA-Z0-9_-]{1,76}$", var.name))
+    error_message = "Queue name must be 1-76 characters: letters, numbers, underscores and hyphens."
+  }
+}
+
+variable "max_receive_count" {
+  type        = number
+  description = "Receives before a message moves to the dead-letter queue"
+  default     = 3
+  validation {
+    condition     = var.max_receive_count >= 1 && var.max_receive_count <= 1000
+    error_message = "max_receive_count must be between 1 and 1000."
+  }
+}
+
+variable "visibility_timeout_seconds" {
+  type        = number
+  description = "How long a received message is hidden from other consumers"
+  default     = 30
+}
+
+variable "alarm_topic_arn" {
+  type        = string
+  description = "ARN of the SNS topic that the dead-letter alarm notifies"
+}
